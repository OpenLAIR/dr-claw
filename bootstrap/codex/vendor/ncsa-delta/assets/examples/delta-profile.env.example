# Copy to a private, non-secret project config and replace every CHANGE_ME.
# Do not store passwords, MFA data, SSH keys, or access tokens here.
DELTA_PROJECT=CHANGE_ME_PROJECT
DELTA_CPU_ACCOUNT=CHANGE_ME_CPU_ACCOUNT
DELTA_GPU_ACCOUNT=CHANGE_ME_GPU_ACCOUNT
DELTA_PROJECT_ROOT=/projects/CHANGE_ME_PROJECT/$USER
DELTA_WORK_ROOT=/work/hdd/CHANGE_ME_PROJECT/$USER
DELTA_NVME_ROOT=/work/nvme/CHANGE_ME_PROJECT/$USER
DELTA_CODE_ROOT=/projects/CHANGE_ME_PROJECT/$USER/code/CHANGE_ME_REPOSITORY
DELTA_LOG_ROOT=/work/hdd/CHANGE_ME_PROJECT/$USER/logs
DELTA_RUN_ROOT=/work/hdd/CHANGE_ME_PROJECT/$USER/runs

# Rebuildable caches belong on work, not HOME.
HF_HOME=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/huggingface
TORCH_HOME=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/torch
PIP_CACHE_DIR=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/pip
CONDA_PKGS_DIRS=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/conda-pkgs
APPTAINER_CACHEDIR=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/apptainer
XDG_CACHE_HOME=/work/hdd/CHANGE_ME_PROJECT/$USER/caches/xdg

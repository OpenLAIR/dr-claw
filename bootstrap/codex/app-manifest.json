{
  "schema_version": 1,
  "bundle_version": "0.1.0",
  "application": {
    "name": "Dr. Claw Web",
    "package_name": "dr-claw",
    "required_paths": [
      "package.json",
      "package-lock.json",
      "server/index.js",
      "scripts/native-runtime.mjs"
    ],
    "safe_host": "127.0.0.1",
    "default_port": 3001,
    "database_relative_path": "database/auth.db"
  },
  "node": {
    "version": "22.23.2",
    "release_base_url": "https://nodejs.org/download/release/v22.23.2",
    "artifacts": {
      "linux-x64": {
        "filename": "node-v22.23.2-linux-x64.tar.xz",
        "sha256": "d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307"
      },
      "linux-arm64": {
        "filename": "node-v22.23.2-linux-arm64.tar.xz",
        "sha256": "fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8"
      }
    },
    "source_of_checksums": "https://nodejs.org/download/release/v22.23.2/SHASUMS256.txt",
    "supported_package_engine": "20.x || 22.x || 24.x"
  },
  "npm": {
    "install": ["ci", "--no-audit", "--no-fund"],
    "build": ["run", "build"],
    "prepare_native": ["run", "native:node"],
    "prune": ["prune", "--omit=dev", "--no-audit", "--no-fund"],
    "verify": ["ls", "--omit=dev", "--depth=0", "--json"]
  },
  "service": {
    "unit_name": "drclaw.service",
    "launcher_name": "drclaw-web",
    "restart_policy": "on-failure",
    "umask": "0077"
  },
  "automatic_scope": [
    "verified user-local Node.js runtime",
    "package-lock.json dependency installation with npm ci",
    "production frontend build and Node native-module preparation",
    "loopback-only environment with generated JWT secret and private SQLite location",
    "user launcher and, when available, an enabled user-systemd unit"
  ],
  "interactive_or_external_scope": [
    "Codex device login and all connector OAuth flows",
    "third-party API keys and provider accounts",
    "the first Dr. Claw browser account registration",
    "TLS or reviewed reverse-proxy configuration for any non-loopback exposure",
    "OS build-tool packages when a native npm dependency has no compatible prebuilt binary"
  ]
}

{
  "$comment": "Opt-in template only. Preserve existing settings: use tools/meta_opt/configure.py to preview and explicitly merge. Logs project and global metadata; see docs/aris-self-evolution.md.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/log_event.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/log_event.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/log_event.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/log_event.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/log_event.sh\"",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/aris-infra/tools/meta_opt/check_ready.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
